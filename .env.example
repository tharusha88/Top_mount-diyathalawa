# ---------------------------------------------------------------
# Top Mountain Resort — configuration
# Copy to .env and fill in. Changes apply on the next page load.
# ---------------------------------------------------------------
APP_ENV=development
# Public URL of the site (used in emails and links)
BASE_URL=http://localhost:3100
# Set to true only behind a proxy/CDN such as Cloudflare (so visitor IPs are read correctly)
TRUST_PROXY=false

# --- Database ---
# mysql = MySQL / MariaDB (create the database + user in your hosting panel first)
# sqlite = a single file in data/ (no setup needed)
DB_CONNECTION=mysql
# On shared hosting (Hostinger, cPanel) the host is usually: localhost
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Admin login (used only to create the first admin account) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# Who gets an email when a booking comes in (comma separated)
ADMIN_NOTIFY_EMAILS=owner@example.com

# --- Email (SMTP). Leave SMTP_HOST empty to save emails to data/outbox/ instead ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# PLACEHOLDER: the resort's own sending address (the website doesn't list an email yet)
MAIL_FROM="Top Mountain Resort <bookings@example.com>"

# --- Resort details shown on the website and in emails (Admin → Website can override them) ---
RESORT_NAME=Top Mountain Resort
RESORT_PHONE=+94 77 736 8264
# WhatsApp number in international format, digits only
RESORT_WHATSAPP=94777368264
# PLACEHOLDER: the resort's email address, shown to guests (empty = not shown)
RESORT_EMAIL=
RESORT_ADDRESS=122/1A, Pahala Kadurugamuwa Road, Diyatalawa, Sri Lanka
# Google Maps: the name to search, the exact spot (latitude,longitude), the listing link and plus code
RESORT_MAP_QUERY=Top Mountain Resort, Diyatalawa, Sri Lanka
RESORT_MAP_COORDS=
RESORT_MAP_PLACE=https://www.google.com/maps/search/?api=1&query=Top+Mountain+Resort+Diyatalawa
RESORT_PLUS_CODE=
RESORT_FACEBOOK=
RESORT_INSTAGRAM=
# "Powered by" credit on the booking page and sign-in screens (empty = none); add a website link if you like
POWERED_BY=Panoralink Business Solutions
POWERED_BY_URL=
CURRENCY=LKR
CHECKIN_TIME=2:00 PM
CHECKOUT_TIME=11:00 AM
# Not used by Top Mountain's home page (its hero video comes from the media build)
HERO_VIDEO=
